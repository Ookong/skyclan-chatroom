+// ── Chat reply button (2026-08-29 猴哥需求) ──
+function replyToMessage(senderId, senderName){
+  var sel = document.getElementById('chat-send-channel');
+  var target = 'dm:' + senderId;
+  var found = false;
+  if(sel){
+    for(var i = 0; i < sel.options.length; i++){
+      if(sel.options[i].value === target){ sel.value = target; found = true; break; }
+    }
+    if(!found){ sel.value = 'all'; }
+  }
+  var ta = document.getElementById('chat-send-content');
+  if(ta){
+    if(!found){ // 作者不在私信下拉（非活跃成员/未加载）→ @all 里点名
+      var prefix = '@' + senderName + ' ';
+      if(ta.value.indexOf(prefix) !== 0){ ta.value = prefix + ta.value; }
+    }
+    ta.focus();
+    ta.setSelectionRange(ta.value.length, ta.value.length);
+    ta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
+  }
+  var statusEl = document.getElementById('chat-send-status');
+  if(statusEl){
+    statusEl.textContent = found ? '↩ 将私信回复给 ' + senderName : '↩ ' + senderName + ' 不在私信列表，切到 @all 并已 @TA';
+  }
+}
+(function(){
+  var list = document.getElementById('chat-history-list');
